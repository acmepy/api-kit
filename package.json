{
  "name": "api",
  "version": "1.2.72",
  "description": "api rest como middleware",
  "keywords": [
    "api",
    "rest",
    "middleware",
    "express"
  ],
  "repository": {
    "type": "git",
    "url": "github:acmepy/api"
  },
  "license": "MIT",
  "author": "Hugo",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/api-server.d.ts",
      "import": "./dist/api-server.js"
    },
    "./client": {
      "types": "./dist/api-client.d.ts",
      "import": "./dist/api-client.js"
    },
    "./vue": {
      "types": "./dist/api-vue.d.ts",
      "import": "./dist/api-vue.js"
    },
    "./cli": {
      "types": "./dist/api-cli.d.ts",
      "import": "./dist/api-cli.js"
    }
  },
  "scripts": {
    "build": "npm run test && rollup -c",
    "build:min": "rollup -c --environment MINIFY:true",
    "prepack": "npm run build",
    "test": "node --test",
    "test:mysql": "node --env-file=.env --test --test-concurrency=1",
    "dev": "node ./example/app.js",
    "dev:mysql": "node --env-file=.env ./example/app.js",
    "lint": "eslint src tests example rollup.config.js eslint.config.js"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "yep": "github:acmepy/yep"
  },
  "peerDependencies": {
    "adm-zip": "^0.6.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "iam": "github:acmepy/iam",
    "logger": "github:acmepy/logger-js",
    "seq": "github:acmepy/seq",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "adm-zip": {
      "optional": true
    },
    "compression": {
      "optional": true
    },
    "cors": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "express-rate-limit": {
      "optional": true
    },
    "helmet": {
      "optional": true
    },
    "iam": {
      "optional": true
    },
    "logger": {
      "optional": true
    },
    "seq": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "eslint": "^10.7.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "fake-indexeddb": "^6.2.5",
    "helmet": "^8.3.0",
    "iam": "github:acmepy/iam",
    "logger": "github:acmepy/logger-js",
    "mysql2": "^3.23.3",
    "rollup": "^4.0.0",
    "seq": "github:acmepy/seq",
    "vue": "^3.5.41"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
